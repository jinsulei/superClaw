{
  "name": "superclaw",
  "version": "1.0.1",
  "private": true,
  "description": "SuperClaw AI control panel",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "serve": "node scripts/serve.js",
    "smoke:life": "node --test tests/life-assistant.test.js",
    "smoke:ecommerce-stage1": "node scripts/smoke-ecommerce-stage1.mjs",
    "smoke:ecommerce-stage2": "node scripts/smoke-ecommerce-stage2.mjs",
    "smoke:ecommerce-stage3": "node scripts/smoke-ecommerce-stage3.mjs",
    "smoke:ecommerce-stage4": "node scripts/smoke-ecommerce-stage4.mjs",
    "smoke:ecommerce-stage56": "node scripts/smoke-ecommerce-stage56.mjs",
    "smoke:compact-chat": "node scripts/smoke-compact-chat.mjs",
    "smoke:file-service": "node scripts/smoke-file-service.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:pack": "pwsh ./build.ps1",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-desktop-client.ps1 -SkipRuntimeDownload -SanitizedTest",
    "verify:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-portable-package.ps1 -RequireFresh",
    "audit:package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/preflight-package-audit.ps1",
    "download:uv": "node scripts/download-uv.js",
    "download:openclaw": "node scripts/download-openclaw.js",
    "version:sync": "node scripts/sync-version.js",
    "version:set": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.0",
    "terser": "^5.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
